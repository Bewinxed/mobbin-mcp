{
  "name": "mobbin-mcp",
  "version": "0.2.0",
  "description": "Unofficial MCP server (Streamable HTTP + OAuth) for searching Mobbin apps, flows, screens and website sections with your own Mobbin account",
  "license": "MIT",
  "repository": "github:Bewinxed/mobbin-mcp",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mobbin",
    "ui",
    "design"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mobbin-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "prepare": "npm run build",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  },
  "private": true
}
